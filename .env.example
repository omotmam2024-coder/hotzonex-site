# Only needed for the WhatsApp assistant webhook (src/app/api/whatsapp/route.ts).
# See README.md "WhatsApp assistant" for how to obtain these from Meta's WhatsApp Cloud API
# and where to set them in Vercel. The rest of the site needs no environment variables.

# Any string you choose; enter the same value in the Meta webhook configuration.
WHATSAPP_VERIFY_TOKEN=

# Meta App Dashboard > WhatsApp > API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Meta App Dashboard > Settings > Basic. Optional but recommended: without it, incoming
# webhook requests are not verified as coming from Meta.
WHATSAPP_APP_SECRET=

# Optional, defaults to v21.0.
WHATSAPP_API_VERSION=
